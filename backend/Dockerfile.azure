FROM python:3.11-slim
WORKDIR /code
COPY requirements.txt requirements-azure.txt ./
RUN pip install --no-cache-dir -r requirements.txt -r requirements-azure.txt
COPY app ./app
RUN useradd -r -u 10001 appuser
USER appuser
ENV APP_MODE=azure PYTHONPATH=/code
EXPOSE 8000
CMD ["uvicorn","app.azure_api:app","--host","0.0.0.0","--port","8000"]
